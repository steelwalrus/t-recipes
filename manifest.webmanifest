---
layout: null
---
{
  "name": "{{ site.title }}",
  "short_name": "{{ site.title }}",
  "description": "{{ site.description }}",
  "start_url": "{{ '/' | relative_url }}",
  "scope": "{{ '/' | relative_url }}",
  "display": "standalone",
  "background_color": "#FAF6EF",
  "theme_color": "#FAF6EF",
  "icons": [
    { "src": "{{ '/assets/icon-192.png' | relative_url }}", "sizes": "192x192", "type": "image/png" },
    { "src": "{{ '/assets/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png" },
    { "src": "{{ '/assets/icon-512.png' | relative_url }}", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
